# ATLAS Frontend (Next.js) environment
# Copy to .env.local and adjust. Values here are used in local development only.

# Browser → backend REST base URL (no trailing slash).
# Local dev: the FastAPI API on port 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Browser → backend WebSocket base URL (no trailing slash).
# Local dev: ws://localhost:8000 — the /ws/ticks and /ws/terminal-events endpoints.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Server-side (Next route handlers / BFF) → backend REST base URL.
# Defaults to NEXT_PUBLIC_API_URL when unset. In Docker this is the internal
# service URL (http://api:8000).
# API_URL=http://api:8000
